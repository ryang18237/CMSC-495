# Copy to backend/.env and fill in locally. NEVER commit the real .env.
ENVIRONMENT=development

# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg://csp:csp@localhost:5432/csp

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-locally-generated-secret
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Default AI provider: "mock" (no key, used by CI), "anthropic" or "openai".
# Members can also pick any provider below that has a key, per message.
AI_PROVIDER=mock

# Your own keys. Keep them out of version control; this file is git-ignored.
# See docs/AI_FEATURES.md, "Getting a key".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Latency budget. One attempt may take AI_TIMEOUT_SECONDS; a retry is only
# started while the turn is still inside AI_RETRY_BUDGET_SECONDS.
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_RETRY_BUDGET_SECONDS=5
