# Copy to backend/.env and fill in locally. NEVER commit the real .env.
ENVIRONMENT=development

# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg://csp:csp@localhost:5432/csp

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-locally-generated-secret
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Default AI provider.
#
#   auto       the shipped default. Uses a local model through Ollama when
#              one is running on this machine, and the built-in advisor
#              otherwise. Nothing to configure either way.
#   ollama     force the local model, even if it is not ready yet.
#   builtin    force the built-in advisor. No key, no account, no cost,
#              works offline, and deterministic -- which is why CI uses it.
#   anthropic  Claude,  needs ANTHROPIC_API_KEY below
#   openai     ChatGPT, needs OPENAI_API_KEY below
#
# Whoever runs the server sets this once. Members never enter a key: they just
# see the models this server can reach, and pick one in the chat.
AI_PROVIDER=auto

# The local model. Install Ollama from https://ollama.com, then:
#
#     ollama pull llama3.2
#
# That is the whole setup -- no key, no account, no per-token cost, and no
# part of a member's record leaves the machine. Any model you have pulled
# works; name it here. See docs/AI_FEATURES.md, "A model on your own machine".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional managed models. Leave blank unless you are running a deployment
# that should use one. Keep keys out of version control; this file is
# git-ignored. See docs/AI_FEATURES.md, "Adding Claude or ChatGPT".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Latency budget. One attempt may take AI_TIMEOUT_SECONDS; a retry is only
# started while the turn is still inside AI_RETRY_BUDGET_SECONDS.
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_RETRY_BUDGET_SECONDS=5
