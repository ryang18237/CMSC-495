# Copy to backend/.env and fill in locally. NEVER commit the real .env.
ENVIRONMENT=development

# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg://csp:csp@localhost:5432/csp

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-locally-generated-secret
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# Default AI provider.
#
#   builtin    the built-in advisor. No key, no account, no cost, works
#              offline. This is the default and the platform is fully usable
#              on it -- leave it alone unless you want a managed model.
#   anthropic  Claude,  needs ANTHROPIC_API_KEY below
#   openai     ChatGPT, needs OPENAI_API_KEY below
#
# Whoever runs the server sets this once. Members never enter a key: they just
# see the models this server can reach, and pick one in the chat.
AI_PROVIDER=builtin

# Optional. Leave both blank to run entirely on the built-in advisor.
# Keep keys out of version control; this file is git-ignored.
# See docs/AI_FEATURES.md, "Adding Claude or ChatGPT".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Latency budget. One attempt may take AI_TIMEOUT_SECONDS; a retry is only
# started while the turn is still inside AI_RETRY_BUDGET_SECONDS.
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_RETRY_BUDGET_SECONDS=5
