# Copy to backend/.env and fill in locally. NEVER commit the real .env.
ENVIRONMENT=development

# PostgreSQL connection used by the application
DATABASE_URL=postgresql+psycopg://csp:csp@localhost:5432/csp

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-locally-generated-secret
JWT_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# AI provider selection: "mock" (no network, used by CI) or "anthropic"
AI_PROVIDER=mock

# Only needed when AI_PROVIDER=anthropic. Keep this out of version control.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
